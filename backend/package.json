{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "npx nodemon src/index.ts",
    "test": "vitest run -c vitest.config.unit.ts",
    "test:watch": "vitest -c vitest.config.unit.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:unit:coverage": "npx vitest run --coverage -c ./vitest.config.unit.ts",
    "test:e2e:watch": "vitest -c vitest.e2e.config.ts",
    "test:unit": "vitest -c ./vitest.config.unit.ts",
    "test:unit:ui": "vitest -c ./vitest.config.unit.ts --ui",
    "test:bruno:setup": "ts-node scripts/updateBrunoAuth.ts",
    "test:bruno": "npm run test:bruno:setup && cd \"bruno/CNC Portal\" && npx bru run -r --env \"CNC URI\"",
    "test:bruno:auth": "npm run test:bruno:setup && cd \"bruno/CNC Portal\" && npx bru run Auth -r --env \"CNC URI\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:files": "prettier --write",
    "prebuild": "npm run prisma:generate",
    "build": "tsc && ([ -z \"$SENTRY_AUTH_TOKEN\" ] || npm run sentry:sourcemaps)",
    "prod": "node  dist/index.js",
    "copy:docs": "npx shx cp src/utils/backend_specs.html dist/utils/backend_specs.html",
    "db:wake": "ts-node scripts/wake-db.ts",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "seed:dev": "NODE_ENV=development ts-node prisma/seed.ts",
    "seed:e2e": "NODE_ENV=test ts-node prisma/seed-e2e.ts",
    "seed:test": "NODE_ENV=test ts-node prisma/seed.ts",
    "seed:staging": "NODE_ENV=staging ts-node prisma/seed.ts",
    "seed:reset": "npx prisma migrate reset --force && npm run seed",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org $SENTRY_ORG --project $SENTRY_PROJECT ./dist && sentry-cli sourcemaps upload --org $SENTRY_ORG --project $SENTRY_PROJECT ./dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.1",
    "@usebruno/cli": "^4.2.0",
    "@vitest/coverage-istanbul": "^5.0.2",
    "eslint": "^10.15.0",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.10",
    "prettier": "3.10.1",
    "prisma": "^7.10.1",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.731.1",
    "@aws-sdk/s3-request-presigner": "^3.731.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/cli": "^3.8.2",
    "@sentry/node": "^11.15.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.2",
    "merkletreejs": "^0.6.0",
    "multer": "^2.0.2",
    "redis": "^6.3.0",
    "siwe": "^3.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "viem": "^2.29.4",
    "yaml": "^2.8.2",
    "yamljs": "^0.3.0",
    "zod": "^4.1.11"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    },
    "@apidevtools/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    }
  }
}
