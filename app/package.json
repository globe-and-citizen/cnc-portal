{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "VITE_E2E=true VITE_APP_NETWORK_ALIAS=hardhat vite",
    "build": "run-s type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:watch": "vitest -u",
    "test:unit:coverage": "npx vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "HEADLESS=false playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "HEADLESS=false playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "pretest:e2e:coverage": "rm -rf coverage/e2e",
    "test:e2e:coverage": "playwright test",
    "coverage:e2e:report": "nyc report",
    "test": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:build:cache": "synpress --headless",
    "test:build:cache:force": "synpress --headless --force",
    "test:headless": "HEADLESS=true playwright test",
    "coverage": "npx serve coverage/",
    "prod": "node dist/index.js",
    "build-only": "vite build",
    "type-check": "vue-tsc --build tsconfig.app.json --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:no-daisy": "node scripts/check-no-daisy.mjs",
    "format": "prettier --write .",
    "format-check": "prettier . --check",
    "format:files": "prettier --write",
    "git:ignore-locally": "git -C .. update-index --assume-unchanged app/src/artifacts/deployed_addresses/chain-31337.json dashboard/app/artifacts/deployed_addresses/chain-31337.json"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
