    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "1.48.2",
    "@synthetixio/synpress": "^4.1.2",
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
