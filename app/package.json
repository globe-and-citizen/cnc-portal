    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "sass": "^1.102.0",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-vue-devtools": "^8.2.1",
