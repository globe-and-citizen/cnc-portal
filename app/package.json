    "@vueuse/core": "^14.4.0",
    "@wagmi/core": "^3.0.0",
    "@wagmi/vue": "^0.4.17",
    "abitype": "^1.1.1",
    "axios": "^1.19.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "events": "^3.3.0",
    "graphql": "^16.14.2",
