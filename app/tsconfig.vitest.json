{
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.ts",
    "test/**/*",
    "auto-imports.d.ts",
    "components.d.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",

    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "jsdom"]
  }
}
